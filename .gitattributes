# Preserve exact artifact bytes independently of core.autocrlf.
* -text
* whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Shell scripts remain portable to WSL/Linux.
*.sh text eol=lf
.gitattributes text eol=lf

# Preserve the CRLF checkout of original tracked text inputs.
/.gitignore text eol=crlf
/Makefile text eol=crlf
/assembler/assembler.py text eol=crlf
/assembler/test_assembler.py text eol=crlf
/goboard.pcf text eol=crlf
